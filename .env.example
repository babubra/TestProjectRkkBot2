# ==================================
# ОБЩИЕ ПЕРЕМЕННЫЕ ДЛЯ ВСЕХ СЕРВИСОВ
# ==================================
# ID администратора бота
ADMIN_ID=7577751
# Смещение временной зоны
APP_TIMEZONE_OFFSET=2

# ==================================
# СЕКРЕТЫ И КЛЮЧИ API
# ==================================
# Токен Telegram бота
BOT_TOKEN=
# API ключ для Perplexity
PERPLEXITY_API_KEY=
# API ключ для Яндекс.Карт (для сборки фронтенда)
VITE_YANDEX_MAPS_API_KEY=

# ==================================
# УЧЕТНЫЕ ДАННЫЕ MEGAPLAN
# ==================================
MEGAPLAN_BASE_URL=
MEGAPLAN_LOGIN=
MEGAPLAN_PASSWORD=
MEGAPLAN_PROGRAM_ID=

# ==================================
# ПЕРЕМЕННЫЕ ДЛЯ ОКРУЖЕНИЯ DOCKER
# ==================================
# URL для фронтенда, который будет использовать бэкэнд (например, для отправки ссылок)
FRONTEND_BASE_URL=http://localhost
# URL для API, который будет использовать фронтенд
VITE_API_BASE_URL=http://localhost:8000

# ==================================
# ПЕРЕМЕННЫЕ ДЛЯ ЛОКАЛЬНОЙ РАЗРАБОТКИ (ВНЕ DOCKER)
# ==================================
# Путь к локальной базе данных
DATABASE_URL=sqlite+aiosqlite:///your_database.db

# ==================================
# ПРОКСИ (обход блокировок)
# ==================================
# Спецсимволы в пароле нужно percent-энкодить: @ -> %40, : -> %3A, / -> %2F

# Proxy сервер для корректной работы NSPD
NSPD_PROXY=user:pass@host:port

# Proxy сервер для Google Gemini API
GEMINI_PROXY=user:pass@host:port

# Proxy сервер для Telegram Bot API (обход блокировки в РФ)
# Поддерживаются протоколы: http, socks5. SOCKS5 заметно быстрее (0.62с против 3.25с).
TELEGRAM_PROXY=socks5://user:pass@host:port